{
  "id": "brd",
  "name": "Business Requirements Document",
  "description": "Fills BRD Sample.docx (title, process, revision, summary table, description blocks).",
  "format": "docx",
  "template_file": "BRD Sample.docx",
  "uses_jinja": false,
  "filler": "brd_sample",
  "slots": [
    {
      "id": "doc_code",
      "label": "Document code / title line",
      "type": "string",
      "required": true,
      "ask_priority": 100,
      "question": "Document header line? (e.g. SE52: Business Requirement Document)",
      "default": "SE52: Business Requirement Document",
      "anchors": []
    },
    {
      "id": "process_name",
      "label": "Process name",
      "type": "string",
      "required": true,
      "ask_priority": 95,
      "question": "Process name? (e.g. 55.10 Capital Asset Acquisition)",
      "anchors": []
    },
    {
      "id": "prepared_by",
      "label": "Prepared by",
      "type": "string",
      "required": true,
      "ask_priority": 90,
      "question": "Prepared by?",
      "default": "YMSLI",
      "anchors": []
    },
    {
      "id": "document_date",
      "label": "Revision date",
      "type": "date",
      "required": true,
      "ask_priority": 85,
      "question": "Document / revision date?",
      "default": "today",
      "anchors": []
    },
    {
      "id": "area_path",
      "label": "Area path",
      "type": "string",
      "required": false,
      "ask_priority": 40,
      "question": "Area path? (optional)",
      "default": "YNS-FnO-ERP",
      "anchors": []
    },
    {
      "id": "overview",
      "label": "Process overview",
      "type": "text",
      "required": true,
      "ask_priority": 80,
      "question": "High-level process description / overview?",
      "anchors": []
    },
    {
      "id": "items",
      "label": "BRD items",
      "type": "list",
      "required": true,
      "ask_priority": 75,
      "question": "One item per line: Type | Name | Description | Acceptance | Flow steps",
      "help": "Type = Epic, Feature, or User Story. Flow is optional (`Request ; Approve ; Capitalize`); missing flows are generated from the description.",
      "anchors": []
    }
  ]
}
